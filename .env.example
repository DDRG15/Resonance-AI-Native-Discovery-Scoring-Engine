# =============================================================================
# .env.example — Project GEMA
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in real values in .env
#
# SECURITY:
#   .env is in .gitignore — NEVER commit real API keys to version control.
#   For deployment: inject these as environment secrets in your CI/CD pipeline.
# =============================================================================

# ── LLM APIs (use ONE primary + ONE fallback) ─────────────────────────────────
# Groq: https://console.groq.com — free tier, extremely fast inference
GROQ_API_KEY=your_groq_api_key_here

# Gemini: https://aistudio.google.com/app/apikey — free tier
GEMINI_API_KEY=your_gemini_api_key_here

# Which LLM to use as primary ("groq" or "gemini")
PRIMARY_LLM=groq

# ── Notion Integration ────────────────────────────────────────────────────────
# Create an integration at https://www.notion.so/my-integrations
# Share your target database with the integration
NOTION_API_KEY=secret_your_notion_key_here
NOTION_DATABASE_ID=your_32_char_database_id_here

# ── Google Sheets Integration ─────────────────────────────────────────────────
# Download service account JSON from Google Cloud Console
# Path to your service account credentials file
GOOGLE_CREDENTIALS_PATH=credentials/google_service_account.json
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ── Scraper Behavior ──────────────────────────────────────────────────────────
# Jitter range in seconds (min and max delay between page actions)
JITTER_MIN_SECONDS=5
JITTER_MAX_SECONDS=15

# Circuit breaker: consecutive null extractions before aborting a domain
CIRCUIT_BREAKER_THRESHOLD=3

# Max consecutive 429/403 responses before aborting entire run
MAX_RATE_LIMIT_HITS=5

# Default TTL: ignore jobs seen within this many hours (0 = no TTL filter)
DEFAULT_TTL_HOURS=0

# ── Database ──────────────────────────────────────────────────────────────────
GEMA_DB_PATH=gema_registry.db

# ── "The Blitz" — Parallelism & Webhook ───────────────────────────────────────
# Max concurrent Chromium tabs inside asyncio.gather().
# Recommended: 3 on a 2-core Docker host. Raise to 5 only if RAM > 4GB.
SCRAPER_CONCURRENCY=3

# DB write-queue batching policy
DB_WRITE_BATCH_SIZE=10
DB_WRITE_FLUSH_TIMEOUT=2.0

# Discord webhook URL (optional — leave empty to disable)
# Get from: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=

# Slack incoming webhook URL (optional — leave empty to disable)
# Get from: api.slack.com/apps → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=

# SRP null-rate drift alert threshold (0.0–1.0). Default: 0.40 (40%)
# If > 40% of SRP cards return null title/company, suspect selector drift.
SRP_NULL_RATE_ALERT_THRESHOLD=0.40
