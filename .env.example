# =============================================================================
# GEMA — Environment Variables Template
# Copy this file to .env and fill in your own keys. Never commit .env.
# =============================================================================

# --- LLM Providers (at least one required) ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Which provider is primary (groq or gemini)
PRIMARY_LLM=groq

# --- Notifications ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
SLACK_WEBHOOK_URL=

# --- Database ---
GEMA_DB_PATH=gema_registry.db
DEFAULT_TTL_HOURS=0

# --- Scraper Tuning ---
JITTER_MIN_SECONDS=5
JITTER_MAX_SECONDS=15
SCRAPER_CONCURRENCY=3
CIRCUIT_BREAKER_THRESHOLD=3
MAX_RATE_LIMIT_HITS=5
SRP_NULL_RATE_ALERT_THRESHOLD=0.4

# --- Integrations (optional) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=
GOOGLE_CREDENTIALS_PATH=credentials/google_service_account.json
GOOGLE_SHEET_ID=
