# =============================================================================
# GEMA — .gitignore
# =============================================================================

# Environment — NEVER commit secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Database files — local state, not source code
*.db
*.db-shm
*.db-wal
*.bak

# Credentials — ignore the key files but track the directory itself
credentials/*.json
credentials/*.p12
*.json
!requirements*.json

# Session cookies — gitkeep the directory, ignore the actual cookie files
cookies/*.json
!cookies/README.md

# camoufox Firefox binary — ~530MB, downloaded at runtime via `python -m camoufox fetch`
.camoufox/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Streamlit
.streamlit/secrets.toml

# Claude Code
.claude/

# Personal data — LLM system prompt, never public
gema_instructions.md

# Archives — may contain .env with live credentials
*.zip
*.tar.gz
*.rar

# ── Private documents — NEVER push to GitHub ──────────────────────────────────
# Rule: if a file is owner-only context, an internal log, a session brief,
# or contains PII, it goes here. Use broad patterns so new files are caught
# automatically without having to update this list.

# Owner-context session briefs
PRIVATE_*.md
DIEGO_LEE_ESTO_*.md

# Phase implementation reports (any phase number, any suffix)
PHASE_*.md

# Internal reports of any kind: audit, hotfix, implementation, backlog, etc.
*_REPORT.md
HOTFIX_*.md
AUDIT_*.md
AUDITORIA_*.md

# Copilot-generated scaffolding — purged 2026-06-02, kept local only.
# Dead VCR-cassette setup that was never wired up + a CI workflow broken by
# construction (working-directory ./gema doesn't exist; the repo root IS gema).
IMPROVEMENTS_*.md
.github/workflows/ci.yml
scripts/scan_fixtures.py
tests/fixtures/
tests/test_migrations.py
tools/

# Job search session results — scraped data with personal context
JOBS_*.md
ANALISIS_*.md
board_profiles.md

# Distribution guide — references owner by name, not a public-facing doc
BETA_GUIDE.md

# Product roadmap — private strategy, not for public GitHub
ROADMAP.md

# README working drafts — review copies, not final documents
README_DRAFT.md
README_*.md
!README.md

# Misc
*.xlsx
*.csv
pivot_instructions.txt

# Personal CV data — use user_profile.yaml.example as template
user_profile.yaml

# Temporary scrape data files — not source code
tier1_raw.json

# Torre personal job search results — never public
torre_job_analysis/
