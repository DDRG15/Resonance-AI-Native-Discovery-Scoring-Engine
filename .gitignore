# =============================================================================
# GEMA — .gitignore
# =============================================================================

# Environment — NEVER commit secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Database files — local state, not source code
*.db
*.db-shm
*.db-wal
*.bak

# Credentials — ignore the key files but track the directory itself
credentials/*.json
credentials/*.p12
*.json
!requirements*.json

# Session cookies — gitkeep the directory, ignore the actual cookie files
cookies/*.json
!cookies/README.md

# camoufox Firefox binary — ~530MB, downloaded at runtime via `python -m camoufox fetch`
.camoufox/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Streamlit
.streamlit/secrets.toml

# Claude Code
.claude/

# Personal data — LLM system prompt, never public
gema_instructions.md

# Archives — may contain .env with live credentials
*.zip
*.tar.gz
*.rar

# Private session briefs — owner context only, never public
PRIVATE_BRIEF.md
PRIVATE_*.md

# Phase implementation reports — internal development notes, never public
PHASE_*_REPORT.md
AUDIT_REPORT.md
HOTFIX_STARLETTE_REPORT.md
IMPLEMENTATION_REPORT.md

# Beta distribution guide — references owner by name, not for public GitHub
BETA_GUIDE.md

# README drafts — intermediate review files, not for public GitHub
README_DRAFT.md

# Misc
*.xlsx
*.csv
pivot_instructions.txt
