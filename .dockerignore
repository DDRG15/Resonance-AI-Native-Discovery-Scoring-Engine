# =============================================================================
# .dockerignore — Project GEMA
# Files excluded from the Docker build context.
# Rule: if it's secret → exclude. If it's large and rebuilt in the image → exclude.
# If it's runtime state mounted as a volume → exclude.
# =============================================================================

# --- SECURITY: never bake secrets or credentials into the image ---
.env
.env.local
.env.*.local
credentials/*.json
credentials/*.p12
cookies/*.json          # session cookies — mount via docker-compose volume

# --- LARGE BINARIES: downloaded during `docker build`, not copied ---
.camoufox/              # camoufox Firefox binary (~530MB) — built by `python -m camoufox fetch`

# --- RUNTIME STATE: mounted as volumes, not baked in ---
*.db
*.db-shm
*.db-wal
*.bak

# --- GIT ---
.git/
.gitignore

# --- PYTHON ARTIFACTS ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.pytest_cache/

# --- TESTING: not needed in production image ---
tests/
pytest.ini

# --- DOCUMENTATION ---
*.md
!README.md

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- EXPORTS / GENERATED FILES ---
*.xlsx
*.csv
*.log
logs/

# --- PRIVATE FILES ---
PRIVATE_*.md
DIEGO_LEE_ESTO_*.md
JOBS_*.md
ANALISIS_*.md
board_profiles.md
tier1_raw.json
gema_instructions.md
pivot_instructions.txt

# --- ARCHIVES ---
*.zip
*.tar.gz
*.rar

# --- CLAUDE CODE ---
.claude/
